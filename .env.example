# Create a key in the Nebius Token Factory console: https://tokenfactory.nebius.com/
NEBIUS_API_KEY=replace-me
# Base URL of the OpenAI-compatible API
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Must be an NVIDIA Nemotron model (the hackathon requires an NVIDIA open source model).
# Model ids change. Run `paperwork models` to list what your key can use.
# Public listings show this id for Token Factory; confirm it with `paperwork models`.
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Where the local memory database lives
PAPERWORK_DB=./paperwork.db
